<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # API bridge -> backend Laravel (api-siamin.bpmpntb.id)
  RewriteRule ^api/(.*)$ /api-bridge.php [L]

  # OG meta renderer: halaman publik shareable -> og.php (link preview WhatsApp/Telegram/FB)
  RewriteRule ^(kegiatan|daftar-peserta|unduh-sertifikat|evaluasi|formulir|laporan-evaluasi|test)(/|$) og.php [L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
